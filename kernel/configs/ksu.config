# Apply AFTER the base defconfig and all Motorola/device fragments.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_OVERLAY_FS=y
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y
# CONFIG_KPROBES is not set
# CONFIG_KPROBE_EVENTS is not set
# CONFIG_KSU_DEBUG is not set
# CONFIG_KRETPROBES is not set
# CONFIG_KSU_KPROBES_HOOK is not set
# CONFIG_KSU_SYSCALL_TABLE_HOOK is not set
# CONFIG_KSU_DISABLE_MANAGER is not set
# CONFIG_KSU_DISABLE_POLICY is not set
